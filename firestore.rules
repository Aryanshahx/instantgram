rules_version = '2';

// InstantGram Firestore security rules (v0.10.0)
// Deploy:  firebase deploy --only firestore --project YOUR_PROJECT_ID
// or paste into: Firebase Console -> Firestore Database -> Rules -> Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // v0.18: Hyper Intelligence decides 'sensitive' / 'modState' (the server).
    // A new post / moment can only say "pending" (= please check me).
    function hiStartOk(d) {
      return !('sensitive' in d) && !('modReasons' in d) && !('modAt' in d)
        && d.get('modState', 'pending') == 'pending';
    }

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function delta(f) { return request.resource.data[f] - resource.data[f]; }
    // same, but a missing old value counts as 0 (fields added in v0.5.0)
    function delta0(f) {
      return request.resource.data.get(f, 0) - resource.data.get(f, 0);
    }
    // Counter unchanged, or moved by exactly +1 / -1
    function stepOk(f) {
      return !changed().hasAny([f])
        || (request.resource.data[f] is int && (delta(f) == 1 || delta(f) == -1));
    }
    function userDoc(u) { return /databases/$(database)/documents/users/$(u); }
    // Private account (followers must be approved)
    function isPrivate(u) {
      return get(userDoc(u)).data.get('isPrivate', false) == true;
    }
    // Has [owner] blocked [other]?
    function blockedBy(owner, other) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(other));
    }

    // ---------------- Users ----------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && request.resource.data.uid == uid
        // v0.13: only the admin website sets these
        && !request.resource.data.keys().hasAny(['verified', 'banned'])
        && (!('country' in request.resource.data)
            || (request.resource.data.country is string
                && request.resource.data.country.size() <= 3));
      allow update: if signedIn() && (
        // Owner edits profile. uid / email can't change. A new username
        // must be reserved for you in the same write (unique names).
        (me() == uid
          && changed().hasOnly(['name', 'bio', 'website', 'photoUrl', 'photoKey',
                                'coverUrl', 'coverKey', 'postsCount',
                                'followingCount', 'followersCount',
                                'language', 'isPrivate', 'country',
                                'username', 'links', 'bioFont', 'bioFonts'])
          && usernameOk(uid) && linksOk()
          // v0.16: many fonts in the bio: [{s, e, f}] (max 60 parts)
          && (!changed().hasAny(['bioFonts'])
              || (request.resource.data.bioFonts is list
                  && request.resource.data.bioFonts.size() <= 60))
          // v0.15: bio font name
          && (!changed().hasAny(['bioFont'])
              || (request.resource.data.bioFont is string
                  && request.resource.data.bioFont.size() <= 20))
          && stepOk('postsCount') && stepOk('followingCount')
          && stepOk('followersCount')
          && (!changed().hasAny(['isPrivate'])
              || request.resource.data.isPrivate is bool)
          && (!changed().hasAny(['language'])
              || (request.resource.data.language is string
                  && request.resource.data.language.size() <= 8))
          && (!changed().hasAny(['country'])
              || (request.resource.data.country is string
                  && request.resource.data.country.size() <= 3)))
        ||
        // Someone follows / unfollows: followersCount +-1 with matching doc
        (changed().hasOnly(['followersCount']) && followOk(uid))
        ||
        // A private account approves / removes this user as follower
        (changed().hasOnly(['followingCount']) && followingOk(uid))
      );
      allow delete: if false;

      function usernameOk(uid) {
        let n = request.resource.data.get('username', '');
        return !changed().hasAny(['username'])
          || (n is string && n.matches('^[a-z0-9._]{3,30}$')
              && getAfter(/databases/$(database)/documents/usernames/$(n)).data.uid == uid);
      }

      // max 3 links: {title, url}
      function linksOk() {
        let l = request.resource.data.get('links', []);
        return !changed().hasAny(['links'])
          || (l is list && l.size() <= 3);
      }

      function followingOk(uid) {
        let f = /databases/$(database)/documents/users/$(uid)/following/$(request.auth.uid);
        return (delta('followingCount') == 1 && existsAfter(f) && !exists(f))
          || (delta('followingCount') == -1 && !existsAfter(f) && exists(f));
      }

      function followOk(uid) {
        let f = /databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid);
        return (delta('followersCount') == 1 && existsAfter(f) && !exists(f))
          || (delta('followersCount') == -1 && !existsAfter(f) && exists(f));
      }

      // followers: you follow a public account, or the owner approves a request
      match /followers/{fid} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          (me() == fid && fid != uid && !isPrivate(uid) && !blockedBy(uid, fid))
          || (me() == uid && exists(/databases/$(database)/documents/users/$(uid)/requests/$(fid))));
        // unfollow, or the owner removes a follower
        allow delete: if signedIn() && (me() == fid || me() == uid);
        allow update: if false;
      }
      match /following/{tid} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          (me() == uid && !blockedBy(tid, uid)
            && (!isPrivate(tid)
                || existsAfter(/databases/$(database)/documents/users/$(tid)/followers/$(uid))))
          || (me() == tid && exists(/databases/$(database)/documents/users/$(tid)/requests/$(uid))));
        allow delete: if signedIn() && (me() == uid || me() == tid);
        allow update: if false;
      }
      // v0.15: highlights = moments kept on the profile
      match /highlights/{hid} {
        allow read: if signedIn();
        allow delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid && highlightOk();

        function highlightOk() {
          let d = request.resource.data;
          return d.keys().hasOnly(['title', 'coverUrl', 'username', 'photoUrl',
                                   'storyIds', 'items', 'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() >= 1 && d.title.size() <= 30
            && d.get('coverUrl', '') is string
            && d.items is list && d.items.size() >= 1 && d.items.size() <= 100
            && d.storyIds is list && d.storyIds.size() <= 100;
        }
      }
      // follow requests to a private account (rid = who asks)
      match /requests/{rid} {
        allow read: if signedIn() && (me() == uid || me() == rid);
        allow create: if signedIn() && me() == rid && rid != uid
          && isPrivate(uid) && !blockedBy(uid, rid)
          && request.resource.data.keys().hasOnly(['createdAt', 'username', 'name', 'photoUrl']);
        allow delete: if signedIn() && (me() == uid || me() == rid);
        allow update: if false;
      }
      // people you blocked (only you can see the list)
      match /blocked/{bid} {
        allow read: if signedIn() && me() == uid;
        allow create, delete: if signedIn() && me() == uid && bid != uid;
        allow update: if false;
      }
      // private info (date of birth) - only you
      match /private/{doc} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['birthDate', 'updatedAt'])
          && (!('birthDate' in request.resource.data)
              || (request.resource.data.birthDate is string
                  && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      }
      match /reposts/{pid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && me() == uid;
        allow update: if false;
      }
      match /saved/{pid} {
        allow read, create, delete: if signedIn() && me() == uid;
        allow update: if false;
      }
      match /notifications/{nid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create: if signedIn() && uid != me()
          && request.resource.data.fromUid == me()
          && request.resource.data.type in ['like', 'comment', 'follow', 'repost',
               'reply', 'comment_like', 'unfollow', 'moment_like'];
        allow update: if signedIn() && me() == uid && changed().hasOnly(['read']);
      }
    }

    // Username reservations (unique usernames + "login with username")
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && name.matches('^[a-z0-9._]{3,30}$');
      // free your old name only while switching to a new one
      allow delete: if signedIn()
        && resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/users/$(me())).data.username != name;
      allow update: if false;
    }

    // ---------------- Posts & clips ----------------
    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == me()
        && request.resource.data.type in ['photo', 'clip']
        && request.resource.data.mediaUrl is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.repostsCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.get('uniqueViews', 0) == 0
        && request.resource.data.get('savesCount', 0) == 0
        && request.resource.data.get('sharesCount', 0) == 0
        && tagsOk() && optionsOk() && hiStartOk(request.resource.data);
      allow update: if signedIn() && (
        (resource.data.authorId == me()
          && changed().hasOnly(['caption', 'tags', 'pinned', 'authorPhotoUrl',
                                'authorUsername', 'pinnedComment',
                                'audience', 'hideLikes', 'hideComments',
                                'hideReposts', 'hideShares', 'profileOnly'])
          && tagsOk() && optionsOk()
          // v0.11: one pinned comment (its id, '' = none)
          && request.resource.data.get('pinnedComment', '') is string
          && request.resource.data.get('pinnedComment', '').size() <= 64)
        ||
        // (the old 'viewsCount' is frozen: views are 'uniqueViews' now)
        (changed().hasOnly(['likesCount', 'commentsCount', 'repostsCount',
                            'sharesCount', 'savesCount', 'uniqueViews'])
          && stepOk('likesCount') && stepOk('commentsCount')
          && stepOk('repostsCount')
          && shareOk() && likeOk() && repostOk() && saveOk() && viewOk())
      );
      allow delete: if signedIn() && resource.data.authorId == me();

      // likesCount must match your like doc
      // optional hashtag list: max 30 items
      function tagsOk() {
        return !('tags' in request.resource.data)
          || (request.resource.data.tags is list
              && request.resource.data.tags.size() <= 30);
      }

      // audience, photos/videos (max 200), filter, cover, music, hidden counts
      function optionsOk() {
        let d = request.resource.data;
        return (!('audience' in d) || d.audience in ['everyone', 'followers', 'only_me'])
          && (!('media' in d) || (d.media is list && d.media.size() >= 1 && d.media.size() <= 200))
          && (!('audioUrl' in d) || d.audioUrl is string)
          && (!('audioName' in d) || (d.audioName is string && d.audioName.size() <= 200))
          && (!('filter' in d) || (d.filter is list && d.filter.size() == 20))
          && (!('thumbUrl' in d) || d.thumbUrl is string)
          && (!('hideLikes' in d) || d.hideLikes is bool)
          && (!('hideComments' in d) || d.hideComments is bool)
          && (!('hideReposts' in d) || d.hideReposts is bool)
          && (!('hideShares' in d) || d.hideShares is bool)
          // v0.16: only on the profile (not in feeds)
          && (!('profileOnly' in d) || d.profileOnly is bool);
      }
      // shares can only go up by 1
      function shareOk() {
        return !changed().hasAny(['sharesCount'])
          || request.resource.data.sharesCount == resource.data.get('sharesCount', 0) + 1;
      }

      function likeOk() {
        let l = /databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid);
        return !changed().hasAny(['likesCount'])
          || (delta('likesCount') == 1 && existsAfter(l) && !exists(l))
          || (delta('likesCount') == -1 && !existsAfter(l) && exists(l));
      }
      // savesCount must match your saved doc
      function saveOk() {
        let s = /databases/$(database)/documents/users/$(request.auth.uid)/saved/$(pid);
        return !changed().hasAny(['savesCount'])
          || (delta0('savesCount') == 1 && existsAfter(s) && !exists(s))
          || (delta0('savesCount') == -1 && !existsAfter(s) && exists(s));
      }
      // uniqueViews +1 only together with YOUR first view doc (not the author)
      function viewOk() {
        let v = /databases/$(database)/documents/posts/$(pid)/views/$(request.auth.uid);
        return !changed().hasAny(['uniqueViews'])
          || (delta0('uniqueViews') == 1 && existsAfter(v) && !exists(v)
              && resource.data.authorId != me());
      }
      // repostsCount must match your repost doc
      function repostOk() {
        let r = /databases/$(database)/documents/users/$(request.auth.uid)/reposts/$(pid);
        return !changed().hasAny(['repostsCount'])
          || (delta('repostsCount') == 1 && existsAfter(r) && !exists(r))
          || (delta('repostsCount') == -1 && !existsAfter(r) && exists(r));
      }

      // the post owner blocked you -> no comments
      function blockedByPostAuthor() {
        let author = get(/databases/$(database)/documents/posts/$(pid)).data.authorId;
        return blockedBy(author, request.auth.uid);
      }

      // One doc per viewer: totals for the author's Analytics.
      match /views/{uid} {
        allow read: if signedIn() && (me() == uid
          || get(/databases/$(database)/documents/posts/$(pid)).data.authorId == me());
        allow create: if signedIn() && me() == uid
          && get(/databases/$(database)/documents/posts/$(pid)).data.authorId != me()
          && request.resource.data.keys().hasOnly(['follower', 'country', 'language',
                'ageGroup', 'source', 'count', 'watchMs', 'completed', 'createdAt'])
          && request.resource.data.count == 1
          && request.resource.data.watchMs == 0
          && request.resource.data.completed == false
          && request.resource.data.get('follower', false) is bool
          && request.resource.data.get('country', '') is string
          && request.resource.data.get('country', '').size() <= 3
          && request.resource.data.get('language', '') is string
          && request.resource.data.get('language', '').size() <= 8
          && request.resource.data.get('ageGroup', '') is string
          && request.resource.data.get('ageGroup', '').size() <= 8
          && request.resource.data.get('source', '') is string
          && request.resource.data.get('source', '').size() <= 12
          // the post's counter goes up in the same write
          && getAfter(/databases/$(database)/documents/posts/$(pid)).data.get('uniqueViews', 0)
             == get(/databases/$(database)/documents/posts/$(pid)).data.get('uniqueViews', 0) + 1;
        allow update: if signedIn() && me() == uid
          && changed().hasOnly(['count', 'watchMs', 'completed', 'updatedAt'])
          && (!changed().hasAny(['count'])
              || (request.resource.data.count is int && delta('count') == 1))
          && (!changed().hasAny(['watchMs'])
              || (request.resource.data.watchMs is int
                  && request.resource.data.watchMs >= resource.data.watchMs
                  && request.resource.data.watchMs <= 21600000))
          && (!changed().hasAny(['completed'])
              || request.resource.data.completed is bool);
        allow delete: if false;
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && me() == uid;
        allow update: if false;
      }
      match /comments/{cid} {
        allow read: if signedIn();
        // v0.8: text and/or a photo / GIF, one level of replies
        allow create: if signedIn()
          && request.resource.data.authorId == me()
          && commentOk(request.resource.data)
          && request.resource.data.get('likesCount', 0) == 0
          && request.resource.data.get('repliesCount', 0) == 0
          && !blockedByPostAuthor();
        // comment author or post owner can delete
        allow delete: if signedIn() && (resource.data.authorId == me()
          || get(/databases/$(database)/documents/posts/$(pid)).data.authorId == me());
        // only the like / reply counters change, by 1; a like needs the
        // like doc (written in the same transaction)
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likesCount', 'repliesCount'])
          && cStep('likesCount') && cStep('repliesCount')
          && commentLikeOk();

        function cDelta(f) {
          return request.resource.data.get(f, 0) - resource.data.get(f, 0);
        }
        function cStep(f) {
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny([f])
            || (request.resource.data[f] is int
                && (cDelta(f) == 1 || cDelta(f) == -1)
                && request.resource.data[f] >= 0);
        }
        function commentLikeOk() {
          let likePath = /databases/$(database)/documents/posts/$(pid)/comments/$(cid)/likes/$(me());
          return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likesCount'])
            || (cDelta('likesCount') == 1 && !exists(likePath) && existsAfter(likePath))
            || (cDelta('likesCount') == -1 && exists(likePath) && !existsAfter(likePath));
        }
        function commentOk(d) {
          let hasPic = d.get('imageUrl', '') != '' || d.get('gifUrl', '') != '';
          // v0.9: answered with a post / clip
          let hasRef = d.get('refPostId', '') != '';
          return d.keys().hasOnly(['authorId', 'authorUsername', 'authorPhotoUrl',
                  'text', 'createdAt', 'parentId', 'replyToUsername',
                  'imageUrl', 'imageKey', 'imageW', 'imageH',
                  'gifUrl', 'gifW', 'gifH', 'likesCount', 'repliesCount',
                  'refPostId', 'refPostType', 'refThumb', 'refAuthor'])
            && d.text is string && d.text.size() <= 1000
            && (d.text.size() > 0 || hasPic || hasRef)
            && d.get('refPostId', '') is string && d.get('refPostId', '').size() <= 60
            && d.get('refPostType', '') in ['', 'photo', 'clip']
            && d.get('refThumb', '') is string && d.get('refThumb', '').size() <= 600
            && d.get('refAuthor', '') is string && d.get('refAuthor', '').size() <= 40
            && d.get('parentId', '') is string && d.get('parentId', '').size() <= 40
            && d.get('replyToUsername', '') is string
            && d.get('replyToUsername', '').size() <= 40
            && d.get('imageUrl', '') is string && d.get('imageUrl', '').size() <= 600
            && d.get('imageKey', '') is string && d.get('imageKey', '').size() <= 300
            && d.get('gifUrl', '') is string && d.get('gifUrl', '').size() <= 600
            && (d.get('gifUrl', '') == '' || d.gifUrl.matches('https://.*'))
            && d.get('imageW', 0) is int && d.get('imageH', 0) is int
            && d.get('gifW', 0) is int && d.get('gifH', 0) is int;
        }

        // v0.8: comment likes, one doc per account
        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if signedIn() && me() == uid
            && request.resource.data.keys().hasOnly(['createdAt']);
          allow delete: if signedIn() && me() == uid;
        }
      }
    }

    // ---------------- Stories (24h) ----------------
    match /stories/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me()
        && request.resource.data.mediaUrl is string
        && hiStartOk(request.resource.data)
        && request.resource.data.get('type', 'photo') in ['photo', 'video']
        && request.resource.data.get('audience', 'everyone') in ['everyone', 'followers', 'only_me'];
      allow delete: if signedIn() && resource.data.authorId == me();
      allow update: if false;

      // v0.15: who watched a moment and how many times (vid = the viewer).
      // Only the moment's owner can list it. Each watch = count + 1.
      match /views/{vid} {
        allow get: if signedIn() && (me() == vid || storyOwner());
        allow list: if signedIn() && storyOwner();
        allow create: if signedIn() && me() == vid && !storyOwner()
          && request.resource.data.keys().hasOnly(['uid', 'username', 'photoUrl', 'count', 'lastAt'])
          && request.resource.data.uid == me()
          && request.resource.data.count == 1
          && request.resource.data.lastAt == request.time
          && viewerInfoOk();
        allow update: if signedIn() && me() == vid && (
          (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['count', 'lastAt', 'username', 'photoUrl'])
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.lastAt == request.time
            && viewerInfoOk())
          ||
          // v0.16: like / unlike the moment (heart)
          (request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['liked', 'likedAt'])
            && request.resource.data.liked is bool
            && request.resource.data.likedAt == request.time));
        allow delete: if false;

        function storyOwner() {
          return get(/databases/$(database)/documents/stories/$(sid)).data.authorId == me();
        }
        function viewerInfoOk() {
          return request.resource.data.get('username', '') is string
            && request.resource.data.get('username', '').size() <= 40
            && request.resource.data.get('photoUrl', '') is string;
        }
      }
    }

    // ---------------- Direct messages ----------------
    // chat id = the two uids sorted and joined with "_"
    match /chats/{cid} {
      allow get: if signedIn() && me() in cid.split('_');
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signedIn()
        && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        // v0.10 ticks: you only set YOUR seen / delivered time
        && onlyMyKey('seen') && onlyMyKey('delivered')
        // v0.13: "typing…" (only your own key)
        && onlyMyKey('typing')
        // v0.11: disappearing messages (off / once seen / 24 h / 7 days)
        && request.resource.data.get('disappear', 'off') in ['off', 'seen', '24h', '7d'];
      allow delete: if false;

      function onlyMyKey(f) {
        return !changed().hasAny([f])
          || (request.resource.data[f] is map
              && request.resource.data[f].diff(resource.data.get(f, {}))
                   .affectedKeys().hasOnly([me()]));
      }

      match /messages/{mid} {
        allow read: if signedIn() && me() in cid.split('_');
        allow create: if signedIn() && me() in cid.split('_')
          && request.resource.data.senderId == me()
          && messageOk(request.resource.data)
          // nobody in the chat blocked you
          && !blockedBy(cid.split('_')[0], me())
          && !blockedBy(cid.split('_')[1], me());
        // v0.9: react (only your own emoji) or "delete for you"
        allow update: if signedIn() && me() in cid.split('_')
          && (reactOk() || hideOk());
        // v0.9: "delete for everyone" = the sender removes it
        // v0.11: disappearing messages: either person removes them
        // ("once seen" ones, or ones whose time is over)
        allow delete: if signedIn() && (resource.data.senderId == me()
          || (me() in cid.split('_')
              && (resource.data.get('vanish', false) == true
                  || (resource.data.get('expireAt', null) is timestamp
                      && resource.data.expireAt < request.time))));

        function messageOk(d) {
          let kind = d.get('kind', 'text');
          let media = kind in ['image', 'gif', 'voice'];
          return d.keys().hasOnly(['senderId', 'createdAt', 'text', 'kind',
                  'postId', 'postType', 'postThumb', 'postAuthor', 'postCaption',
                  'mediaUrl', 'mediaKey', 'width', 'height', 'durationMs',
                  'lat', 'lng', 'address', 'replyTo', 'forwarded',
                  'expireAt', 'vanish', 'callStatus', 'video', 'durationSec',
                  'font'])
            // v0.16: font of a text message (see BioFont ids)
            && d.get('font', '') is string && d.get('font', '').size() <= 20
            && kind in ['text', 'post', 'image', 'gif', 'voice', 'location',
                        'call', 'system']
            // v0.11: disappearing messages (max 7 days + a little)
            && (!('expireAt' in d) || (d.expireAt is timestamp
                  && d.expireAt > request.time
                  && d.expireAt < request.time + duration.value(8, 'd')))
            && d.get('vanish', false) is bool
            // v0.11: call log in the chat ("Missed voice call", "Video call 2:31")
            && (kind != 'call' || (d.callStatus in ['ended', 'missed', 'declined', 'busy', 'failed']
                  && d.video is bool
                  && d.durationSec is int && d.durationSec >= 0 && d.durationSec <= 86400))
            // v0.11: "alice turned on disappearing messages"
            && (kind != 'system' || (d.text.size() > 0 && d.text.size() <= 200))
            && d.text is string && d.text.size() <= 2000
            && (kind != 'text' || d.text.size() > 0)
            && (!media || (d.mediaUrl is string && d.mediaUrl.matches('https://.*')
                           && d.mediaUrl.size() <= 600))
            && (kind != 'location' || (d.lat is number && d.lng is number
                  && d.lat >= -90 && d.lat <= 90 && d.lng >= -180 && d.lng <= 180))
            && d.get('address', '') is string && d.get('address', '').size() <= 300
            && (!('replyTo' in d) || (d.replyTo is map
                  && d.replyTo.keys().hasOnly(['id', 'senderId', 'text'])
                  && d.replyTo.text is string && d.replyTo.text.size() <= 300))
            && d.get('forwarded', false) is bool;
        }
        function reactOk() {
          let old = resource.data.get('reactions', {});
          let now = request.resource.data.get('reactions', {});
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && now is map
            && now.diff(old).affectedKeys().hasOnly([me()])
            && (!(me() in now) || (now[me()] is string && now[me()].size() <= 16));
        }
        function hideOk() {
          let old = resource.data.get('hiddenFor', []);
          let now = request.resource.data.get('hiddenFor', []);
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
            && now is list && now.size() == old.size() + 1
            && now.hasAll(old) && now.hasAll([me()]) && !old.hasAll([me()]);
        }
      }
    }

    // ---------------- v0.10: Active status ----------------
    // presence/{uid} = {lastActive, hidden}
    // v0.13: set by the admin website only (verified badges ...)
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // v0.18: Hyper Intelligence. Scores: only the server (admin website).
    match /moderation/{mid} {
      allow read, write: if false;
    }
    // v0.18: strikes (set by the admin website); you can read your own
    match /strikes/{uid} {
      allow get: if signedIn() && me() == uid;
      allow list, write: if false;
    }

    // v0.13: reports for the admin website (users can only add)
    match /reports/{rid} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['kind', 'reporterUid',
             'reporterUsername', 'targetId', 'postId', 'targetUid',
             'reason', 'message', 'createdAt'])
        && request.resource.data.reporterUid == me()
        && request.resource.data.kind in ['post', 'clip', 'comment', 'user']
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('reporterUsername', '') is string
        && request.resource.data.get('reporterUsername', '').size() <= 40
        && request.resource.data.get('targetId', '') is string
        && request.resource.data.get('targetId', '').size() <= 128
        && request.resource.data.get('postId', '') is string
        && request.resource.data.get('postId', '').size() <= 128
        && request.resource.data.get('targetUid', '') is string
        && request.resource.data.get('targetUid', '').size() <= 128
        && request.resource.data.get('reason', '') is string
        && request.resource.data.get('reason', '').size() <= 80
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 2000;
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['lastActive', 'hidden', 'online'])
        && request.resource.data.hidden is bool
        // v0.11: true while the app is open
        && request.resource.data.get('online', false) is bool
        && (request.resource.data.lastActive == null
            || request.resource.data.lastActive == request.time);
      allow delete: if false;
    }

    // ---------------- v0.10: push tokens (ring when the app is closed) ----
    // Only you. Our server reads them with its own key (no rules there).
    match /pushTokens/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['tokens', 'updatedAt'])
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 10;
    }

    // ---------------- v0.11: your chat settings ----------------
    // prefs/{uid} = {pinnedChats, mutedChats, mutedCalls, cleared, updatedAt}
    // v0.12: + pushOff = notification kinds you switched off (likes, ...)
    // Only you. Our server reads mutedChats / mutedCalls with its own key.
    match /prefs/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['pinnedChats', 'mutedChats',
             'mutedCalls', 'cleared', 'updatedAt', 'pushOff', 'vanishChats'])
        // v0.13: disappearing messages only on your phone
        && request.resource.data.get('vanishChats', {}) is map
        && request.resource.data.get('vanishChats', {}).size() <= 1000
        && request.resource.data.get('pushOff', []) is list
        && request.resource.data.get('pushOff', []).size() <= 20
        && request.resource.data.get('pinnedChats', []) is list
        && request.resource.data.get('pinnedChats', []).size() <= 20
        && request.resource.data.get('mutedChats', []) is list
        && request.resource.data.get('mutedChats', []).size() <= 1000
        && request.resource.data.get('mutedCalls', []) is list
        && request.resource.data.get('mutedCalls', []).size() <= 1000
        && request.resource.data.get('cleared', {}) is map
        && request.resource.data.get('cleared', {}).size() <= 1000;
    }

    // ---------------- v0.10: voice / video calls ----------------
    match /calls/{callId} {
      function inCall(d) { return me() == d.callerId || me() == d.calleeId; }
      allow get: if signedIn() && inCall(resource.data);
      // "who is calling me" (ringing list)
      allow list: if signedIn() && resource.data.calleeId == me();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['callerId', 'callerName',
             'callerPhoto', 'calleeId', 'calleeName', 'calleePhoto', 'video',
             'status', 'offer', 'createdAt'])
        && request.resource.data.callerId == me()
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != me()
        && request.resource.data.status == 'ringing'
        && request.resource.data.video is bool
        && request.resource.data.callerName is string
        && request.resource.data.callerName.size() <= 60
        && request.resource.data.get('callerPhoto', '') is string
        && request.resource.data.get('callerPhoto', '').size() <= 600
        && request.resource.data.offer is map
        && request.resource.data.offer.sdp is string
        && request.resource.data.offer.sdp.size() <= 20000
        && request.resource.data.createdAt == request.time
        // the person did not block you
        && !blockedBy(request.resource.data.calleeId, me());
      allow update: if signedIn() && inCall(resource.data)
        && changed().hasOnly(['status', 'answer', 'acceptedAt', 'endedAt'])
        && request.resource.data.status in ['ringing', 'accepted', 'declined',
             'ended', 'missed', 'busy']
        // only the person called can answer / accept / say busy
        && (!changed().hasAny(['answer', 'acceptedAt'])
            || me() == resource.data.calleeId)
        && (!(request.resource.data.status in ['accepted', 'busy'])
            || me() == resource.data.calleeId)
        // a finished call stays finished
        && resource.data.status in ['ringing', 'accepted'];
      allow delete: if false;

      // network candidates (each side writes its own)
      match /candidates/{cid} {
        function theCall() {
          return get(/databases/$(database)/documents/calls/$(callId)).data;
        }
        allow read: if signedIn() && inCall(theCall());
        allow create: if signedIn() && inCall(theCall())
          && request.resource.data.keys().hasOnly(['from', 'candidate',
               'sdpMid', 'sdpMLineIndex', 'createdAt'])
          && request.resource.data.from == me()
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
