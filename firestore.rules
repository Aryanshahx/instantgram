rules_version = '2';

// InstantGram Firestore security rules (v0.4.0)
// Deploy:  firebase deploy --only firestore --project YOUR_PROJECT_ID
// or paste into: Firebase Console -> Firestore Database -> Rules -> Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function delta(f) { return request.resource.data[f] - resource.data[f]; }
    // Counter unchanged, or moved by exactly +1 / -1
    function stepOk(f) {
      return !changed().hasAny([f])
        || (request.resource.data[f] is int && (delta(f) == 1 || delta(f) == -1));
    }
    function userDoc(u) { return /databases/$(database)/documents/users/$(u); }
    // Private account (followers must be approved)
    function isPrivate(u) {
      return get(userDoc(u)).data.get('isPrivate', false) == true;
    }
    // Has [owner] blocked [other]?
    function blockedBy(owner, other) {
      return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(other));
    }

    // ---------------- Users ----------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && request.resource.data.uid == uid;
      allow update: if signedIn() && (
        // Owner edits profile. uid / username / email can't change.
        (me() == uid
          && changed().hasOnly(['name', 'bio', 'website', 'photoUrl', 'photoKey',
                                'coverUrl', 'coverKey', 'postsCount',
                                'followingCount', 'followersCount',
                                'language', 'isPrivate'])
          && stepOk('postsCount') && stepOk('followingCount')
          && stepOk('followersCount')
          && (!changed().hasAny(['isPrivate'])
              || request.resource.data.isPrivate is bool)
          && (!changed().hasAny(['language'])
              || (request.resource.data.language is string
                  && request.resource.data.language.size() <= 8)))
        ||
        // Someone follows / unfollows: followersCount +-1 with matching doc
        (changed().hasOnly(['followersCount']) && followOk(uid))
        ||
        // A private account approves / removes this user as follower
        (changed().hasOnly(['followingCount']) && followingOk(uid))
      );
      allow delete: if false;

      function followingOk(uid) {
        let f = /databases/$(database)/documents/users/$(uid)/following/$(request.auth.uid);
        return (delta('followingCount') == 1 && existsAfter(f) && !exists(f))
          || (delta('followingCount') == -1 && !existsAfter(f) && exists(f));
      }

      function followOk(uid) {
        let f = /databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid);
        return (delta('followersCount') == 1 && existsAfter(f) && !exists(f))
          || (delta('followersCount') == -1 && !existsAfter(f) && exists(f));
      }

      // followers: you follow a public account, or the owner approves a request
      match /followers/{fid} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          (me() == fid && fid != uid && !isPrivate(uid) && !blockedBy(uid, fid))
          || (me() == uid && exists(/databases/$(database)/documents/users/$(uid)/requests/$(fid))));
        // unfollow, or the owner removes a follower
        allow delete: if signedIn() && (me() == fid || me() == uid);
        allow update: if false;
      }
      match /following/{tid} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          (me() == uid && !blockedBy(tid, uid)
            && (!isPrivate(tid)
                || existsAfter(/databases/$(database)/documents/users/$(tid)/followers/$(uid))))
          || (me() == tid && exists(/databases/$(database)/documents/users/$(tid)/requests/$(uid))));
        allow delete: if signedIn() && (me() == uid || me() == tid);
        allow update: if false;
      }
      // follow requests to a private account (rid = who asks)
      match /requests/{rid} {
        allow read: if signedIn() && (me() == uid || me() == rid);
        allow create: if signedIn() && me() == rid && rid != uid
          && isPrivate(uid) && !blockedBy(uid, rid)
          && request.resource.data.keys().hasOnly(['createdAt', 'username', 'name', 'photoUrl']);
        allow delete: if signedIn() && (me() == uid || me() == rid);
        allow update: if false;
      }
      // people you blocked (only you can see the list)
      match /blocked/{bid} {
        allow read: if signedIn() && me() == uid;
        allow create, delete: if signedIn() && me() == uid && bid != uid;
        allow update: if false;
      }
      // private info (date of birth) - only you
      match /private/{doc} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['birthDate', 'updatedAt'])
          && (!('birthDate' in request.resource.data)
              || (request.resource.data.birthDate is string
                  && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')));
      }
      match /reposts/{pid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && me() == uid;
        allow update: if false;
      }
      match /saved/{pid} {
        allow read, create, delete: if signedIn() && me() == uid;
        allow update: if false;
      }
      match /notifications/{nid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create: if signedIn() && uid != me()
          && request.resource.data.fromUid == me()
          && request.resource.data.type in ['like', 'comment', 'follow', 'repost'];
        allow update: if signedIn() && me() == uid && changed().hasOnly(['read']);
      }
    }

    // Username reservations (unique usernames + "login with username")
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == me()
        && name.matches('^[a-z0-9._]{3,30}$');
      allow update, delete: if false;
    }

    // ---------------- Posts & clips ----------------
    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == me()
        && request.resource.data.type in ['photo', 'clip']
        && request.resource.data.mediaUrl is string
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 2200
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.repostsCount == 0
        && request.resource.data.viewsCount == 0
        && request.resource.data.get('sharesCount', 0) == 0
        && tagsOk() && optionsOk();
      allow update: if signedIn() && (
        (resource.data.authorId == me()
          && changed().hasOnly(['caption', 'tags', 'pinned', 'authorPhotoUrl',
                                'audience', 'hideLikes', 'hideComments',
                                'hideReposts', 'hideShares'])
          && tagsOk() && optionsOk())
        ||
        (changed().hasOnly(['likesCount', 'commentsCount', 'repostsCount',
                            'viewsCount', 'sharesCount'])
          && stepOk('likesCount') && stepOk('commentsCount')
          && stepOk('repostsCount') && stepOk('viewsCount')
          && shareOk() && likeOk() && repostOk())
      );
      allow delete: if signedIn() && resource.data.authorId == me();

      // likesCount must match your like doc
      // optional hashtag list: max 30 items
      function tagsOk() {
        return !('tags' in request.resource.data)
          || (request.resource.data.tags is list
              && request.resource.data.tags.size() <= 30);
      }

      // audience, photos (max 10), filter, cover, hidden counts
      function optionsOk() {
        let d = request.resource.data;
        return (!('audience' in d) || d.audience in ['everyone', 'followers', 'only_me'])
          && (!('media' in d) || (d.media is list && d.media.size() >= 1 && d.media.size() <= 10))
          && (!('filter' in d) || (d.filter is list && d.filter.size() == 20))
          && (!('thumbUrl' in d) || d.thumbUrl is string)
          && (!('hideLikes' in d) || d.hideLikes is bool)
          && (!('hideComments' in d) || d.hideComments is bool)
          && (!('hideReposts' in d) || d.hideReposts is bool)
          && (!('hideShares' in d) || d.hideShares is bool);
      }
      // shares can only go up by 1
      function shareOk() {
        return !changed().hasAny(['sharesCount'])
          || request.resource.data.sharesCount == resource.data.get('sharesCount', 0) + 1;
      }

      function likeOk() {
        let l = /databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid);
        return !changed().hasAny(['likesCount'])
          || (delta('likesCount') == 1 && existsAfter(l) && !exists(l))
          || (delta('likesCount') == -1 && !existsAfter(l) && exists(l));
      }
      // repostsCount must match your repost doc
      function repostOk() {
        let r = /databases/$(database)/documents/users/$(request.auth.uid)/reposts/$(pid);
        return !changed().hasAny(['repostsCount'])
          || (delta('repostsCount') == 1 && existsAfter(r) && !exists(r))
          || (delta('repostsCount') == -1 && !existsAfter(r) && exists(r));
      }

      // the post owner blocked you -> no comments
      function blockedByPostAuthor() {
        let author = get(/databases/$(database)/documents/posts/$(pid)).data.authorId;
        return blockedBy(author, request.auth.uid);
      }

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && me() == uid;
        allow update: if false;
      }
      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorId == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && !blockedByPostAuthor();
        // comment author or post owner can delete
        allow delete: if signedIn() && (resource.data.authorId == me()
          || get(/databases/$(database)/documents/posts/$(pid)).data.authorId == me());
        allow update: if false;
      }
    }

    // ---------------- Stories (24h) ----------------
    match /stories/{sid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == me()
        && request.resource.data.mediaUrl is string
        && request.resource.data.get('type', 'photo') in ['photo', 'video']
        && request.resource.data.get('audience', 'everyone') in ['everyone', 'followers', 'only_me'];
      allow delete: if signedIn() && resource.data.authorId == me();
      allow update: if false;
    }

    // ---------------- Direct messages ----------------
    // chat id = the two uids sorted and joined with "_"
    match /chats/{cid} {
      allow get: if signedIn() && me() in cid.split('_');
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && me() in request.resource.data.members
        && cid == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signedIn()
        && me() in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && me() in cid.split('_');
        allow create: if signedIn() && me() in cid.split('_')
          && request.resource.data.senderId == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          // nobody in the chat blocked you
          && !blockedBy(cid.split('_')[0], me())
          && !blockedBy(cid.split('_')[1], me());
        allow update, delete: if false;
      }
    }
  }
}
