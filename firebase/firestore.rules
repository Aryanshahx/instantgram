rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // a report's weight matches the reporter's trust (set by the admin panel, 50 until then):
    // under 25 = 1, under 75 = 2, else 3 (the app's reportPoints() does the same)
    function reportPointsOk(points) {
      let t = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('trust', 50);
      return (t < 25 && points == 1) || (t >= 25 && t < 75 && points == 2) || (t >= 75 && points == 3);
    }
    // true if the write only touches the listed fields
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // username -> uid lookup (used to keep usernames unique)
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // changing your username releases the old name
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // the owner links the email to the username (so the username can be used to log in)
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // emails blocked in the admin panel cannot make a new profile
      allow create: if signedIn() && request.auth.uid == uid && !('banned' in request.resource.data)
        && !request.resource.data.keys().hasAny(['verified', 'bannedUntil', 'warnings', 'trust', 'strikes', 'flags'])
        && !(request.auth.token.email is string
             && exists(/databases/$(database)/documents/blockedEmails/$(request.auth.token.email.lower())));
      // owner edits anything except the ban (only the admin panel sets it);
      // anyone may change followersCount (follow/unfollow)
      allow update: if signedIn() && (
        (request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'bannedReason'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'bannedUntil', 'warnings', 'trust', 'strikes', 'flags'])) ||
        onlyChanges(['followersCount']));
      allow delete: if false;

      // people who follow {uid}: the follower writes their own doc
      match /followers/{followerId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == followerId;
      }
      // posts {uid} bookmarked: private to the owner
      // my audience lists ("Close friends"...): only me
      match /audiences/{listId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // highlights on {uid}'s profile: everyone signed in sees them, only the owner writes
      match /highlights/{highlightId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /saved/{postId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // posts {uid} reposted: anybody signed in can read (they are shown on the profile), only the owner writes
      match /reposts/{postId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      // people I blocked: private to the owner
      match /blocked/{targetId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // private accounts: a person asks (requests), the owner approves (approved),
      // and the asker then follows (sent_requests is the asker's own list)
      match /requests/{requesterId} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == requesterId);
        allow create: if signedIn() && request.auth.uid == requesterId;
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == requesterId);
      }
      match /approved/{requesterId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == requesterId);
      }
      match /sent_requests/{targetId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // people {uid} follows: only the owner writes
      match /following/{targetId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Activity: likes, comments, replies and follows.
    // Anybody signed in may write a line into somebody else's list (that is how a like
    // reaches its author); only the owner reads it and marks it as seen.
    // Push addresses of a person's phones: only that person. The media signer reads them with
    // the service account (rules do not apply to it).
    // Reports from the app (posts, clips, comments). Anybody signed in may send one; only the
    // admin panel reads and handles them (it uses the service account).
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['kind', 'postId', 'commentId', 'comment', 'ownerId',
             'ownerUsername', 'by', 'byUsername', 'reason', 'text', 'status', 'createdAt', 'chatId'])
        // a chat report only for a chat the reporter is in
        && (!('chatId' in request.resource.data)
            || (request.resource.data.chatId is string
                && request.auth.uid in request.resource.data.chatId.split('_')))
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if false;
    }

    // emails the admin panel blocked: the app checks one before signing up (no listing)
    match /blockedEmails/{email} {
      allow get: if true;
      allow list, write: if false;
    }

    // the admin panel's review queue (only the signer reads and writes it)
    match /modQueue/{id} {
      allow read, write: if false;
    }

    // app settings from the admin panel (auto-hide after N reports...)
    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // people active per day (admin panel charts): +1 once a day per person
    match /dailyStats/{day} {
      allow read: if false;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['active'])
        && request.resource.data.active == 1;
      allow update: if signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active == resource.data.active + 1;
      allow delete: if false;
    }

    match /pushTokens/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /notifications/{uid} {
      match /items/{itemId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn();
        allow update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
        && !request.resource.data.keys().hasAny(['hidden', 'reportCount', 'reportWeight']);
      // author edits anything but the report fields and the photo check result; anyone may
      // change like/comment counters; a report adds exactly 1 to reportCount and the
      // reporter's weight (1, 2 or 3 by their trust) to reportWeight, once per person
      allow update: if signedIn() && (
        (resource.data.authorId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['hidden', 'reportCount', 'reportWeight', 'sensitive', 'nsfw', 'imgCheck']))
        || onlyChanges(['likeCount', 'superCount', 'commentCount', 'viewCount', 'shareCount', 'repostCount'])
        || (onlyChanges(['reportCount'])
            && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
            && !exists(/databases/$(database)/documents/posts/$(postId)/reporters/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/reporters/$(request.auth.uid)))
        || (onlyChanges(['reportCount', 'reportWeight'])
            && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1
            && reportPointsOk(request.resource.data.reportWeight - resource.data.get('reportWeight', 0))
            && !exists(/databases/$(database)/documents/posts/$(postId)/reporters/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/posts/$(postId)/reporters/$(request.auth.uid))));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // who reported the post (one each); nobody reads them
      match /reporters/{uid} {
        allow create: if signedIn() && request.auth.uid == uid;
        allow read, update, delete: if false;
      }

      // one document per person who viewed the post (so everybody counts once)
      match /views/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        // the author may edit the words; everybody may change the like counter
        // the owner of the post may pin or unpin a comment
        allow update: if signedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) ||
          (get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])) ||
          (resource.data.authorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'edited', 'editedAt']))
        );
        // comment author OR the post author can delete
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );

        // who liked the comment
        match /likes/{likerId} {
          allow read: if signedIn();
          allow create, delete: if signedIn() && likerId == request.auth.uid;
        }
      }
    }

    // direct messages: chats/{uidA_uidB} (uids in alphabetical order) and its messages
    match /chats/{chatId} {
      // opening a chat that does not exist yet is allowed (it is created right after)
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      // members update the preview, the "seen" times and their own chat settings
      // (pin, mute calls, mute messages, disappearing messages), never the member list
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && onlyChanges(['lastText', 'lastAt', 'lastSender', 'seen', 'pinnedId', 'pinnedPreview', 'pinnedBy', 'pinned', 'muteCalls', 'muteMessages', 'vanish', 'vanishBy', 'vanishAt'])
        && request.resource.data.get('vanish', '') in ['', 'seen', '24h', '7d'];
      // deleting a chat from the inbox (the app removes the messages first)
      allow delete: if signedIn() && request.auth.uid in resource.data.members;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        // text, photo, GIF, voice note, location, a shared post, a call line or a note
        // (+ reply / forwarded / disappearing)
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'text', 'createdAt', 'mediaUrl', 'width', 'height',
            'duration', 'lat', 'lng', 'postId', 'postThumb', 'postTitle',
            'postAuthor', 'postIsClip', 'replyTo', 'forwarded', 'callVideo', 'callStatus',
            'vanish', 'expireAt', 'font'])
          && request.resource.data.get('type', 'text') in ['text', 'image', 'gif', 'voice', 'location', 'post', 'call', 'system']
          && request.resource.data.get('vanish', '') in ['', 'seen', '24h', '7d']
          && (!('expireAt' in request.resource.data) || request.resource.data.expireAt is timestamp)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.get('type', 'text') != 'text' || request.resource.data.text.size() > 0)
          && request.resource.data.get('mediaUrl', '') is string
          && request.resource.data.get('mediaUrl', '').size() <= 600
          && request.resource.data.get('replyTo', {}) is map
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        // members: react (own emoji only), hide for themselves, pin; the sender can also
        // delete a message for everyone (the content is wiped, the stub stays)
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && (
            (onlyChanges(['reactions'])
              && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
            || (onlyChanges(['hiddenFor'])
              && request.auth.uid in request.resource.data.hiddenFor
              && request.resource.data.hiddenFor.size() <= 2)
            || onlyChanges(['pinned'])
            || (resource.data.senderId == request.auth.uid
              && request.resource.data.deleted == true
              && onlyChanges(['deleted', 'text', 'mediaUrl', 'postThumb', 'postTitle', 'lat', 'lng', 'replyTo', 'pinned']))
          );
        // the sender removes a message, and a member emptying the chat removes them all
        allow delete: if signedIn()
          && (resource.data.senderId == request.auth.uid
              || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members);
      }
    }

    // voice and video calls: the ring. Both people watch the document; the audio and
    // video go through the call provider, never through Firestore.
    match /calls/{callId} {
      allow get, list: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.keys().hasOnly(['callerId', 'calleeId', 'video', 'status', 'createdAt']);
      // caller or callee: move the call along (ringing -> accepted / declined / ended / missed)
      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
        && onlyChanges(['status', 'answeredAt', 'endedAt'])
        && request.resource.data.status in ['ringing', 'accepted', 'declined', 'ended', 'missed'];
      allow delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // who watched it: the viewer writes their own line (first time count 1, then +1 per
      // rewatch); only the author reads the list (and each viewer their own line)
      match /views/{viewerId} {
        function story() {
          return get(/databases/$(database)/documents/stories/$(storyId)).data;
        }
        allow read: if signedIn()
          && (request.auth.uid == viewerId || story().authorId == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == viewerId
          && story().authorId != request.auth.uid
          && request.resource.data.keys().hasOnly(['username', 'photoUrl', 'first', 'last', 'count'])
          && request.resource.data.count == 1;
        allow update: if signedIn() && request.auth.uid == viewerId
          && ((onlyChanges(['last', 'count'])
               && request.resource.data.count == resource.data.count + 1)
              || (onlyChanges(['liked', 'superHeart'])
               && request.resource.data.liked is bool
               && request.resource.data.superHeart is bool));
        allow delete: if signedIn() && story().authorId == request.auth.uid;
      }
    }

    // moments for one audience list: only the people on it (the author is on it too)
    match /privateStories/{storyId} {
      allow read: if signedIn() && request.auth.uid in resource.data.audience;
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.audience is list
        && request.auth.uid in request.resource.data.audience
        && request.resource.data.audience.size() <= 501;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /views/{viewerId} {
        function pstory() {
          return get(/databases/$(database)/documents/privateStories/$(storyId)).data;
        }
        allow read: if signedIn()
          && (request.auth.uid == viewerId || pstory().authorId == request.auth.uid);
        allow create: if signedIn() && request.auth.uid == viewerId
          && pstory().authorId != request.auth.uid
          && request.auth.uid in pstory().audience
          && request.resource.data.keys().hasOnly(['username', 'photoUrl', 'first', 'last', 'count'])
          && request.resource.data.count == 1;
        allow update: if signedIn() && request.auth.uid == viewerId
          && ((onlyChanges(['last', 'count'])
               && request.resource.data.count == resource.data.count + 1)
              || (onlyChanges(['liked', 'superHeart'])
               && request.resource.data.liked is bool
               && request.resource.data.superHeart is bool));
        allow delete: if signedIn() && pstory().authorId == request.auth.uid;
      }
    }

    // people whose story views I want to hear about (the media signer reads it to send alerts)
    match /storyAlerts/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
