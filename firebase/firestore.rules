rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // true if the write only touches the listed fields
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // username -> uid lookup (used to keep usernames unique)
    match /usernames/{name} {
      allow get: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // changing your username releases the old name
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      // the owner links the email to the username (so the username can be used to log in)
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // owner edits anything; anyone may change followersCount (follow/unfollow)
      allow update: if signedIn() && (request.auth.uid == uid || onlyChanges(['followersCount']));
      allow delete: if false;

      // people who follow {uid}: the follower writes their own doc
      match /followers/{followerId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == followerId;
      }
      // posts {uid} bookmarked: private to the owner
      match /saved/{postId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // posts {uid} reposted: anybody signed in can read (they are shown on the profile), only the owner writes
      match /reposts/{postId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
      // people I blocked: private to the owner
      match /blocked/{targetId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // private accounts: a person asks (requests), the owner approves (approved),
      // and the asker then follows (sent_requests is the asker's own list)
      match /requests/{requesterId} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == requesterId);
        allow create: if signedIn() && request.auth.uid == requesterId;
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == requesterId);
      }
      match /approved/{requesterId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == requesterId);
      }
      match /sent_requests/{targetId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      // people {uid} follows: only the owner writes
      match /following/{targetId} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Activity: likes, comments, replies and follows.
    // Anybody signed in may write a line into somebody else's list (that is how a like
    // reaches its author); only the owner reads it and marks it as seen.
    match /notifications/{uid} {
      match /items/{itemId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn();
        allow update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      // author edits anything; anyone may change like/comment counters
      allow update: if signedIn() && (resource.data.authorId == request.auth.uid
                                      || onlyChanges(['likeCount', 'commentCount', 'viewCount', 'shareCount', 'repostCount']));
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && request.auth.uid == uid;
      }

      // one document per person who viewed the post (so everybody counts once)
      match /views/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == uid;
        allow update, delete: if false;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        // the author may edit the words; everybody may change the like counter
        // the owner of the post may pin or unpin a comment
        allow update: if signedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount']) ||
          (get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned'])) ||
          (resource.data.authorId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'edited', 'editedAt']))
        );
        // comment author OR the post author can delete
        allow delete: if signedIn() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
        );

        // who liked the comment
        match /likes/{likerId} {
          allow read: if signedIn();
          allow create, delete: if signedIn() && likerId == request.auth.uid;
        }
      }
    }

    // direct messages: chats/{uidA_uidB} (uids in alphabetical order) and its messages
    match /chats/{chatId} {
      // opening a chat that does not exist yet is allowed (it is created right after)
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      // members update the preview and the "seen" times, never the member list
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && onlyChanges(['lastText', 'lastAt', 'lastSender', 'seen', 'pinnedId', 'pinnedPreview', 'pinnedBy']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        // text, photo, GIF, voice note, location, a shared post or a call line (+ reply / forwarded)
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'text', 'createdAt', 'mediaUrl', 'width', 'height',
            'duration', 'lat', 'lng', 'postId', 'postThumb', 'postTitle',
            'postAuthor', 'postIsClip', 'replyTo', 'forwarded', 'callVideo', 'callStatus'])
          && request.resource.data.get('type', 'text') in ['text', 'image', 'gif', 'voice', 'location', 'post', 'call']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.get('type', 'text') != 'text' || request.resource.data.text.size() > 0)
          && request.resource.data.get('mediaUrl', '') is string
          && request.resource.data.get('mediaUrl', '').size() <= 600
          && request.resource.data.get('replyTo', {}) is map
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        // members: react (own emoji only), hide for themselves, pin; the sender can also
        // delete a message for everyone (the content is wiped, the stub stays)
        allow update: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && (
            (onlyChanges(['reactions'])
              && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid]))
            || (onlyChanges(['hiddenFor'])
              && request.auth.uid in request.resource.data.hiddenFor
              && request.resource.data.hiddenFor.size() <= 2)
            || onlyChanges(['pinned'])
            || (resource.data.senderId == request.auth.uid
              && request.resource.data.deleted == true
              && onlyChanges(['deleted', 'text', 'mediaUrl', 'postThumb', 'postTitle', 'lat', 'lng', 'replyTo', 'pinned']))
          );
        allow delete: if false;
      }
    }

    // voice and video calls: the ring. Both people watch the document; the audio and
    // video go through the call provider, never through Firestore.
    match /calls/{callId} {
      allow get, list: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.status == 'ringing'
        && request.resource.data.keys().hasOnly(['callerId', 'calleeId', 'video', 'status', 'createdAt']);
      // caller or callee: move the call along (ringing -> accepted / declined / ended / missed)
      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid || resource.data.calleeId == request.auth.uid)
        && onlyChanges(['status', 'answeredAt', 'endedAt'])
        && request.resource.data.status in ['ringing', 'accepted', 'declined', 'ended', 'missed'];
      allow delete: if false;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }
  }
}
